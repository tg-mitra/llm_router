# Copy this file to .env and fill in your own values. .env is gitignored.

# Hugging Face Hub token, used only by training/train.py when downloading
# the embedding model. Optional -- without it, downloads fall back to
# unauthenticated (lower rate limits, slower). Get one at
# https://huggingface.co/settings/tokens (a "Read" token is sufficient).
HF_TOKEN=
